# Server Configuration
PORT=3001

# Admin PIN / Password Hash (salt:hash format generated via `node server/scripts/hash-pin.js <PIN>`)
# REQUIRED for admin login in production
ADMIN_PIN_HASH=

# Session Time-To-Live in milliseconds (Default: 7200000 = 2 hours)
SESSION_TTL_MS=7200000

# Allowed CORS Origins (comma-separated). Leave empty to allow standard localhost and default origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://auuzp.github.io

# Firebase Cloud Firestore Configuration (Optional - falls back to local JSON if not set)
# Option A: Path to serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_KEY=

# Option B: Individual environment variables
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

